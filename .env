HOST=0.0.0.0
PORT=12244

DEBUG=0
CUDA_VISIBLE_DEVICES=0

## cosyvoice2, cosyvoice3, cosyvoice3_streamflow, cosyvoice3_streamflow_cacheprompt, cosyvoice3_streamflow_streaming
VERSION=cosyvoice3_streamflow_cacheprompt
TTS_MODEL_DIR=./assets/Fun-CosyVoice3-0.5B-2512
DEFAULT_SPEAKER_CACHE=./assets/default_speaker_cache_cv3.pt
CONFIG_PATH=./config.yaml
## `FRONTEND_MODE` supports `ttsfrd` and `wetext`.
FRONTEND_MODE=wetext
TTSFRD_RESOURCE_PATH=./assets/CosyVoice-ttsfrd/resource
NOVASR_MODEL_PATH=./assets/novasr_v2.bin
TORCH_CUDA_ARCH_LIST=8.9

#################### LLM ####################
## `LLM_ENGINE_MODE` supports `sglang` and `vllm`.
LLM_ENGINE_MODE=vllm
LLM_NUM_GPUS=0.5
## SGLang
SGLANG_MEM_FRACTION_STATIC=0.9
SGLANG_MAX_RUNNING_REQUESTS=8
SGLANG_CONTEXT_LENGTH=8192
SGLANG_MAX_PREFILL_TOKENS=8192
## vLLM
VLLM_GPU_MEMORY_UTILIZATION=0.3
VLLM_MAX_NUM_SEQS=8
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_BATCHED_TOKENS=8192

#################### FLOW ####################
FLOW_TRT_WORKSPACE_SIZE=2
NUM_FLOW_ESTIMATORS=2
FLOW_PROMPT_CACHE_SIZE=2
FLOW_NUM_GPUS=0.1
NUM_FLOW_ACTORS=1
FLOW_DTYPE=fp16 # fp16, fp32
FLOW_JIT=0
FLOW_TRT=0
FLOW_COMPILE=0

#################### HIFT ####################
HIFT_NUM_GPUS=0.05
NUM_HIFT_ACTORS=1
HIFT_TRT=0
HIFT_COMPILE=0
